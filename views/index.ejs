<div class="row">
    <div class="col-12">
        <div class="terminal-card">
            <h2>Chuckflix - Local Video Streaming</h2>
            <div class="input-group mb-3">
                <input type="text" class="form-control" id="searchInput" placeholder="Search videos...">
                <button class="btn btn-primary" type="button" id="searchButton">Search</button>
            </div>
        </div>
    </div>
</div>

<div class="row" id="videoGrid">
    <!-- Videos will be dynamically loaded here -->
</div>

<div class="modal fade" id="videoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Video Player</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="video-container">
                    <video id="videoPlayer" class="w-100" controls></video>
                    <div class="progress-bar">
                        <div class="progress-bar-fill" id="progressFill"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>"
                style="width:100%">
            <div class="w3-display-bottomright w3-large w3-container w3-padding-16 w3-black">

        <!-- Admin Upload Button -->
        <% if (user && user.role === 'admin') { %>
        <div class="fixed-bottom mb-4">
            <a href="/upload" class="btn btn-success btn-lg">
                <i class="fas fa-upload"></i> Upload Video
            </a>
        </div>
        <% } %>
        <div class="w3-display-container mySlides">
            <img src="data:image/jpeg;base64,"
                style="width:100%">
            <div class="w3-display-middle w3-large w3-container w3-padding-16 w3-black">
                Fallout
            </div>
        </div>

        <button class="w3-button w3-display-left w3-black" onclick="plusDivs(-1)">&#10094;</button>
        <button class="w3-button w3-display-right w3-black" onclick="plusDivs(1)">&#10095;</button>

    </div>

    <script>
        var slideIndex = 1;
        showDivs(slideIndex);

        function plusDivs(n) {
            showDivs(slideIndex += n);
        }

        function showDivs(n) {
            var i;
            var x = document.getElementsByClassName("mySlides");
            if (n > x.length) {
                slideIndex = 1
            }
            if (n < 1) {
                slideIndex = x.length
            }
            for (i = 0; i < x.length; i++) {
                x[i].style.display = "none";
            }
            x[slideIndex - 1].style.display = "block";
        }
    </script>[slideIndex - 1].style.display = "block"; }
    </script>
    <div class="row">
        <div class="col-12">
            <div class="alert alert-info">
                Welcome to Chuckflix! Use the search bar above to find your favorite videos.
            </div>
        </div>
    </div>
    <%- include ("../views/partials/footer") %>