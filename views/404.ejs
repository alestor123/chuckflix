<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - Chuckflix</title>
    
    <!-- Emoji Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>">
    
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .error-container {
            min-height: calc(100vh - 60px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        
        .error-content {
            text-align: center;
            max-width: 600px;
            background: var(--card-bg);
            border-radius: 8px;
            padding: 3rem 2rem;
            border: 1px solid var(--border-color);
        }
        
        .error-code {
            font-size: 8rem;
            font-weight: 300;
            color: var(--accent-primary);
            margin: 0;
            line-height: 1;
        }
        
        .error-title {
            font-size: 2rem;
            font-weight: 400;
            color: var(--primary-text);
            margin: 1rem 0;
        }
        
        .error-description {
            font-size: 1.1rem;
            color: var(--muted-text);
            margin-bottom: 2rem;
            line-height: 1.6;
        }
        
        .error-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .error-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.7;
        }
        
        @media (max-width: 768px) {
            .error-code {
                font-size: 5rem;
            }
            
            .error-title {
                font-size: 1.5rem;
            }
            
            .error-actions {
                flex-direction: column;
                align-items: center;
            }
            
            .error-actions .btn {
                width: 200px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="header-container">
            <a href="/viewer/browse" class="site-logo">CHUCKFLIX</a>
            <nav class="main-nav">
                <ul class="nav-menu">
                    <li><a href="/viewer/browse">Media</a></li>
                    <li><a href="/about">About</a></li>
                </ul>
                <div class="user-actions">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <span style="color: var(--muted-text); font-size: 0.9rem;">Welcome, <%= user.username %></span>
                        <form method="POST" action="/logout" style="display: inline;">
                            <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
                        </form>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary btn-sm">Login</a>
                    <% } %>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="error-container">
            <div class="error-content">
                <div class="error-icon">🎬</div>
                <h1 class="error-code">404</h1>
                <h2 class="error-title">Page Not Found</h2>
                <p class="error-description">
                    Oops! The page you're looking for seems to have gone missing. 
                    It might have been moved, deleted, or you entered the wrong URL.
                </p>
                <div class="error-actions">
                    <a href="/viewer/browse" class="btn btn-primary">Browse Media</a>
                    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
                    <a href="/about" class="btn btn-secondary">About Chuckflix</a>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-links">
                    <a href="/viewer/browse">Media</a>
                    <a href="/about">About</a>
                    <a href="#contact">Contact</a>
                    <a href="#privacy">Privacy</a>
                </div>
                <p>&copy; 2024 Chuckflix. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>