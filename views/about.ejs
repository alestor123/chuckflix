<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About - Chuckflix</title>
    
    <!-- Emoji Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>">
    
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .about-hero {
            background: linear-gradient(135deg, var(--secondary-bg) 0%, var(--tertiary-bg) 100%);
            padding: 4rem 0;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }
        
        .about-hero h1 {
            font-size: 3rem;
            font-weight: 300;
            color: var(--primary-text);
            margin-bottom: 1rem;
        }
        
        .about-hero p {
            font-size: 1.2rem;
            color: var(--muted-text);
            max-width: 600px;
            margin: 0 auto;
        }
        
        .about-section {
            padding: 3rem 0;
        }
        
        .about-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .feature-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .feature-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-primary);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .feature-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            display: block;
        }
        
        .feature-title {
            font-size: 1.3rem;
            font-weight: 500;
            color: var(--primary-text);
            margin-bottom: 1rem;
        }
        
        .feature-description {
            color: var(--muted-text);
            line-height: 1.6;
        }
        
        .stats-section {
            background: var(--secondary-bg);
            padding: 3rem 0;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            text-align: center;
        }
        
        .stat-item {
            padding: 1rem;
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: 300;
            color: var(--accent-primary);
            display: block;
            margin-bottom: 0.5rem;
        }
        
        .stat-label {
            color: var(--secondary-text);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .team-section {
            padding: 3rem 0;
        }
        
        .team-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 2rem;
            text-align: center;
            max-width: 400px;
            margin: 0 auto;
        }
        
        .team-avatar {
            width: 80px;
            height: 80px;
            background: var(--accent-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 1rem auto;
            color: var(--primary-text);
        }
        
        @media (max-width: 768px) {
            .about-hero h1 {
                font-size: 2rem;
            }
            
            .about-hero p {
                font-size: 1rem;
            }
            
            .about-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="header-container">
            <a href="/viewer/browse" class="site-logo">CHUCKFLIX</a>
            <nav class="main-nav">
                <ul class="nav-menu">
                    <li><a href="/viewer/browse">Media</a></li>
                    <li><a href="/about" class="active">About</a></li>
                </ul>
                <div class="user-actions">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <span style="color: var(--muted-text); font-size: 0.9rem;">Welcome, <%= user.username %></span>
                        <form method="POST" action="/logout" style="display: inline;">
                            <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
                        </form>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary btn-sm">Login</a>
                    <% } %>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Hero Section -->
        <section class="about-hero">
            <div class="container">
                <h1>About Chuckflix</h1>
                <p>Your personal streaming platform for local media. Experience premium video streaming with complete control over your content library.</p>
            </div>
        </section>

        <!-- Features Section -->
        <section class="about-section">
            <div class="container">
                <h2 class="section-title">Why Choose Chuckflix?</h2>
                <div class="about-grid">
                    <div class="feature-card">
                        <span class="feature-icon">🎬</span>
                        <h3 class="feature-title">Local Streaming</h3>
                        <p class="feature-description">
                            Stream your personal video collection directly from your local server. 
                            No internet required, complete privacy guaranteed.
                        </p>
                    </div>
                    
                    <div class="feature-card">
                        <span class="feature-icon">🔒</span>
                        <h3 class="feature-title">Secure & Private</h3>
                        <p class="feature-description">
                            Your content stays on your network. Role-based access control ensures 
                            only authorized users can access your media library.
                        </p>
                    </div>
                    
                    <div class="feature-card">
                        <span class="feature-icon">📱</span>
                        <h3 class="feature-title">Multi-Device</h3>
                        <p class="feature-description">
                            Responsive design works seamlessly across desktop, tablet, and mobile devices. 
                            Stream anywhere on your local network.
                        </p>
                    </div>
                    
                    <div class="feature-card">
                        <span class="feature-icon">⚡</span>
                        <h3 class="feature-title">Fast & Efficient</h3>
                        <p class="feature-description">
                            Optimized for performance with automatic thumbnail generation, 
                            resume playback, and efficient video streaming.
                        </p>
                    </div>
                    
                    <div class="feature-card">
                        <span class="feature-icon">🎯</span>
                        <h3 class="feature-title">Easy Management</h3>
                        <p class="feature-description">
                            Simple admin interface for uploading, organizing, and managing your 
                            video collection with metadata and genre tagging.
                        </p>
                    </div>
                    
                    <div class="feature-card">
                        <span class="feature-icon">🌟</span>
                        <h3 class="feature-title">Modern Interface</h3>
                        <p class="feature-description">
                            Clean, intuitive design inspired by popular streaming platforms. 
                            Search, browse, and discover your content effortlessly.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="stats-section">
            <div class="container">
                <h2 class="section-title">Platform Statistics</h2>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-number">100%</span>
                        <div class="stat-label">Local Control</div>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">0</span>
                        <div class="stat-label">External Dependencies</div>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">∞</span>
                        <div class="stat-label">Storage Capacity</div>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">24/7</span>
                        <div class="stat-label">Availability</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Technology Section -->
        <section class="about-section">
            <div class="container">
                <h2 class="section-title">Built With Modern Technology</h2>
                <div class="team-card">
                    <div class="team-avatar">💻</div>
                    <h3 class="feature-title">Tech Stack</h3>
                    <p class="feature-description">
                        <strong>Backend:</strong> Node.js, Express.js, MongoDB<br>
                        <strong>Frontend:</strong> EJS, CSS3, JavaScript<br>
                        <strong>Features:</strong> File Upload, Video Streaming, User Authentication<br>
                        <strong>Media:</strong> FFmpeg Integration, Thumbnail Generation
                    </p>
                </div>
            </div>
        </section>

        <!-- Use Cases Section -->
        <section class="about-section" style="background: var(--secondary-bg); padding: 3rem 0;">
            <div class="container">
                <h2 class="section-title">Perfect For</h2>
                <div class="about-grid">
                    <div class="feature-card">
                        <span class="feature-icon">🏠</span>
                        <h3 class="feature-title">Home Media Server</h3>
                        <p class="feature-description">
                            Create your personal Netflix at home. Stream media, shows, 
                            and personal videos to any device on your network.
                        </p>
                    </div>
                    
                    <div class="feature-card">
                        <span class="feature-icon">🏢</span>
                        <h3 class="feature-title">Office Presentations</h3>
                        <p class="feature-description">
                            Share training videos, presentations, and company content 
                            securely within your organization.
                        </p>
                    </div>
                    
                    <div class="feature-card">
                        <span class="feature-icon">🎓</span>
                        <h3 class="feature-title">Educational Content</h3>
                        <p class="feature-description">
                            Distribute educational videos, lectures, and learning materials 
                            in schools, universities, or training centers.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-links">
                    <a href="/viewer/browse">Media</a>
                    <a href="/about">About</a>
                    <a href="#contact">Contact</a>
                    <a href="#privacy">Privacy</a>
                </div>
                <p>&copy; 2024 Chuckflix. All rights reserved.</p>
            </div>
        </div>
    </footer>
</body>
</html>
