<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= video.title %> - Chuckflix</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="header-container">
            <a href="/viewer/browse" class="site-logo">CHUCKFLIX</a>
            <nav class="main-nav">
                <div class="user-actions">
                    <a href="/viewer/browse" class="btn btn-secondary btn-sm">← Back to Media</a>
                    <form method="POST" action="/logout" style="display: inline;">
                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
                    </form>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <section class="player-container">
            <div class="container">
                <div class="player-wrapper">
                    <video controls class="video-player" preload="metadata" id="videoPlayer">
                        <source src="/viewer/stream/<%= video.id %>/<%= initialVariant.id %>" type="<%= initialVariant.format === 'webm' ? 'video/webm' : 'video/mp4' %>">
                        Your browser does not support the video tag.
                    </video>

                    <label class="form-label" for="variantSelect">Playback version</label>
                    <select id="variantSelect" class="form-control">
                        <% variants.forEach(variant => { %>
                            <option value="<%= variant.id %>" data-type="<%= variant.format === 'webm' ? 'video/webm' : 'video/mp4' %>" <%= variant.id === initialVariant.id ? 'selected' : '' %>><%= variant.quality %> / <%= variant.format.toUpperCase() %></option>
                        <% }) %>
                    </select>
                    
                    <div class="player-info">
                        <h1 class="player-title"><%= video.title %></h1>
                        
                        <div class="player-meta">
                            <span><%= formatDuration(video.duration) %></span>
                            <span><%= video.uploadDate.getFullYear() %></span>
                            <span><%= video.views %> views</span>
                        </div>
                        
                        <% if (video.description) { %>
                            <p class="player-description"><%= video.description %></p>
                        <% } %>
                        
                        <% if (video.tags && video.tags.length > 0) { %>
                            <div class="media-genres">
                                <% video.tags.forEach(tag => { %>
                                    <span class="genre-tag"><%= tag %></span>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>
        <% if (related.length) { %>
            <section class="media-section">
                <div class="container">
                    <h2 class="section-title">More Like This</h2>
                    <div class="media-grid">
                        <% related.forEach(item => { %>
                            <a class="media-card" href="/viewer/watch/<%= item.id %>">
                                <div class="media-poster"><img src="/viewer/thumbnail/<%= item.id %>" alt="<%= item.title %>" onerror="this.style.display='none'"></div>
                                <div class="media-info"><h3 class="media-title"><%= item.title %></h3><p><%= item.reason %></p></div>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2024 Chuckflix. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        const video = document.getElementById('videoPlayer');
        const videoId = '<%= video.id %>';
        const source = video.querySelector('source');
        const variantSelect = document.getElementById('variantSelect');
        const savedProgress = <%= Number(savedProgress) || 0 %>;
        let lastSavedAt = 0;
        
        // Load saved progress
        if (savedProgress > 5) video.addEventListener('loadedmetadata', () => { video.currentTime = savedProgress; }, { once: true });

        variantSelect.addEventListener('change', () => {
            const position = video.currentTime;
            const wasPlaying = !video.paused;
            const option = variantSelect.selectedOptions[0];
            source.src = `/viewer/stream/${videoId}/${variantSelect.value}`;
            source.type = option.dataset.type;
            video.load();
            video.addEventListener('loadedmetadata', () => {
                video.currentTime = position;
                if (wasPlaying) video.play();
            }, { once: true });
        });
        
        // Save progress every 10 seconds
        video.addEventListener('timeupdate', () => {
            if (video.currentTime - lastSavedAt >= 10) {
                lastSavedAt = video.currentTime;
                saveProgress(false);
            }
        });
        video.addEventListener('pause', () => saveProgress(false));
        video.addEventListener('ended', () => saveProgress(true));
        function saveProgress(completed) {
            if (!Number.isFinite(video.currentTime)) return;
            fetch(`/viewer/progress/${videoId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
                body: JSON.stringify({ progressSeconds: video.currentTime, completed })
            });
        }
    </script>
</body>
</html>
